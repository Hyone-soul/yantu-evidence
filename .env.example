# 首次启动先浏览已保存资料，不发起外部任务。
APP_OFFLINE=1
PORT=4327

# 空字符串表示直连；需要代理时填写自己的地址。
APP_HTTP_PROXY=

# 联网补充时配置服务端凭据，并将APP_OFFLINE改为0。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash

# 可选：使用外部凭据目录、自定义数据库或Python命令。
# APP_CREDENTIALS_DIR=../credentials
# APP_DB_PATH=./data/kaoyan.sqlite
# PYTHON_BIN=python
